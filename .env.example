# Copy to .env and fill in. Never commit the real .env file.
# Production: set DJANGO_DEBUG=False and provide all values below.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Comma-separated, e.g. myapp.example.com,localhost
DJANGO_ALLOWED_HOSTS=
# Comma-separated full origins, e.g. https://myapp.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
RAPIDAPI_KEY=
