# Copy to .env and fill in. Never commit the real .env file.
# Production: set DJANGO_DEBUG=False and provide all values below.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Comma-separated, e.g. myapp.example.com,localhost
DJANGO_ALLOWED_HOSTS=
# Comma-separated full origins, e.g. https://myapp.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
RAPIDAPI_KEY=
OMDB_API_KEY=
# Watchmode API key (free at https://api.watchmode.com/requestApiKey/): search page browse lists
# (popular, by year, by streaming service). Posters for those lists come from OMDb.
WATCHMODE_API_KEY=
# Trailer YouTube ids come from KinoCheck (free, no key). Set to False to turn the lookup off.
KINOCHECK_ENABLED=True
# RapidAPI key for the IMDb232 movie news feed (the app's news ticker and latest articles).
IMDB232_RAPIDAPI_KEY=
# OpenRouter key for translating takes and comments. Translation is disabled when empty.
OPENROUTER_API_KEY=
# Optional: any chat model slug available on OpenRouter.
OPENROUTER_TRANSLATE_MODEL=openai/gpt-4o-mini
# Optional: country code for where-to-watch providers (default us).
STREAMING_COUNTRY=us
